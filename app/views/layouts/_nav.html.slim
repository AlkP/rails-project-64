nav.navbar.navbar-expand-lg.navbar-light.bg-light
  .container-fluid
    a.navbar-brand[href="#{root_path}"]
      | AlkP_railsProject64
    button.navbar-toggler[type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent'
      aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation']
      span.navbar-toggler-icon
    #navbarSupportedContent.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active[aria-current='page' href="#{root_path}"]
            = I18n.t('main_nav.main')
        - if current_user&.admin?
          li.nav-item
            a.nav-link[href="#{users_path}"]
              = I18n.t('main_nav.users')
        - if current_user
          li.nav-item
            a.nav-link[href="#{new_post_path}"]
              = I18n.t('main_nav.new_post')
      form.d-flex
        nav-item.dropdown
          a#userDropdown.nav-link.dropdown-toggle[href='#' data-bs-toggle='dropdown']
            = user_signed_in? ? current_user.email : I18n.t('main_nav.user_menu')

          ul.dropdown-menu.dropdown-menu-end[aria-labelledby='userDropdown']
            - if user_signed_in?
              li
                a.dropdown-item[href="#{user_path(current_user.id)}"]
                  = I18n.t('main_nav.profile')
              li
                hr.dropdown-divider
              li
                a.dropdown-item[data-turbo-method='delete' href="#{destroy_user_session_path}"]
                  = I18n.t('main_nav.exit')
            - else
              li
                a.dropdown-item[href="#{new_user_session_path}"]
                  = I18n.t('main_nav.login')
              li
                a.dropdown-item[href="#{new_user_registration_path}"]
                  = I18n.t('main_nav.register')
