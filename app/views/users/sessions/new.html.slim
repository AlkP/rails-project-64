h2
  br
= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
  .form-group
    = f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'email', class: 'form-control'
    .small#emailHelp.form-text.text-muted
      = I18n.t('views.users.sessions.new.email_description')
  br
  .form-group
    = f.password_field :password, autocomplete: 'current-password', placeholder: 'Password', class: 'form-control'
  br

  .actions
    = f.submit I18n.t('views.users.sessions.new.submit'), class: 'btn btn-primary form-control'
  br
  br
  - if devise_mapping.rememberable?
    .field
      = f.check_box :remember_me
      = f.label I18n.t('views.users.sessions.new.remember_me')
